EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy projects can use EXPO_PUBLIC_SUPABASE_ANON_KEY instead. Never put a
# Supabase secret/service-role key in an EXPO_PUBLIC_ variable.

# Web preview uses in-memory SQLite by default to avoid browser file-lock crashes.
# Set this to 1 only if you need browser data to survive refreshes and you keep one tab open.
EXPO_PUBLIC_PERSIST_WEB_SQLITE=0
